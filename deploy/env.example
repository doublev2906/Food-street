# Mẫu file env PRODUCTION trên server. Đặt tại: /etc/food_street/env
# Sinh secret:  cd backend && mix phx.gen.secret
# Phân quyền:   sudo chmod 600 /etc/food_street/env && sudo chown pancake /etc/food_street/env

MIX_ENV=prod
PHX_SERVER=true
PORT=4003
PHX_HOST=ten-mien-cua-ban.com

SECRET_KEY_BASE=thay-bang-chuoi-tu-mix-phx-gen-secret
DATABASE_URL=ecto://food_street:mat_khau_manh@localhost/food_street_prod

# Tăng nếu tải cao
POOL_SIZE=10

# Key Gemini phân loại tin phản hồi nhà bán (hết món / báo lấy hàng / báo thanh toán).
# Lấy key AIza… từ Google AI Studio. Để trống thì relay nguyên văn như cũ.
GEMINI_API_KEY=

# Token tài khoản BOT Panchat — dùng cho tin tự động (relay webhook, báo số dư, lịch).
# Tin do admin bấm vẫn dùng token của admin. Để trống thì luồng tự động bỏ qua gửi.
PANCHAT_BOT_TOKEN=
