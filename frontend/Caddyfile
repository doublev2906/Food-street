# Caddy serve frontend (HTTP thuần) trên cổng WEB_PORT (mặc định 3200) + proxy /api.
# TLS do nginx phía trước terminate (cert *.pancake.vn), nên ở đây KHÔNG bật TLS.
# Đổi cổng qua biến WEB_PORT (truyền từ docker-compose).
:{$WEB_PORT:3200} {
	encode zstd gzip

	root * /srv

	# Gọi API -> backend container (mạng nội bộ docker)
	handle /api/* {
		reverse_proxy backend:4003 {
			# nginx ngoài đã terminate TLS; báo Phoenix biết request gốc là HTTPS
			# để force_ssl (prod.exs) KHÔNG redirect 301 loop.
			header_up X-Forwarded-Proto https
		}
	}

	# Trang HTML chia sẻ: folder share/ của repo (mount read-only vào /data/share).
	# Đưa file lên bằng tab "Chia sẻ HTML" trong admin hoặc `make share` dưới máy dev.
	redir /share /share/ 308
	handle /share/* {
		# Phải đăng nhập: hỏi backend (đọc cookie fs_share) trước khi trả file. Chưa
		# đăng nhập -> backend trả 302 về /login?next=<trang đang mở>, Caddy chuyển nguyên.
		forward_auth backend:4003 {
			uri /api/share_auth
			# Như /api: báo Phoenix request gốc là HTTPS để force_ssl không redirect.
			header_up X-Forwarded-Proto https
		}
		# Dùng handle (không strip prefix) để X-Forwarded-Uri giữ nguyên /share/...;
		# /share/<file> -> /data/share/<file>.
		root * /data
		header {
			# Sandbox: trang chạy ở origin riêng nên JS trong file upload KHÔNG đọc được
			# localStorage (token đăng nhập) của app cùng domain. JS/form/popup vẫn chạy.
			Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals allow-downloads"
			X-Content-Type-Options nosniff
			# Luôn hỏi lại server (qua cả bước kiểm tra đăng nhập) -> upload bản mới là
			# thấy ngay, đăng xuất rồi thì không xem lại được từ cache. private: cấm proxy cache.
			Cache-Control "private, no-cache"
		}
		file_server {
			hide .*
			browse {
				sort time desc
			}
		}
	}

	# Ảnh nền theme anime nặng vài trăm KB, không có hash trong tên -> cho browser
	# cache 7 ngày (đổi ảnh thì tối đa 7 ngày user mới thấy, hoặc đổi tên file).
	@anime path /anime/*
	header @anime Cache-Control "public, max-age=604800"

	# SPA fallback cho React Router
	handle {
		try_files {path} /index.html
		file_server
	}
}
